# AgentOS Tidemark editor configuration (Phase 0 draft, 2026-10-16)
# See https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go: gofmt uses tabs.
[*.go]
indent_style = tab
indent_size = 4

[{go.mod,go.sum}]
indent_style = tab

# BPF C follows Linux kernel style.
[*.{c,h}]
indent_style = tab
indent_size = 8

[{Makefile,*.mk}]
indent_style = tab
indent_size = 8

[*.{sh,bash}]
indent_style = space
indent_size = 2

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[{Containerfile,Containerfile.*,Dockerfile}]
indent_style = space
indent_size = 4

[*.spec]
indent_style = space
indent_size = 4

# Markdown: two trailing spaces can be a line break.
[*.md]
trim_trailing_whitespace = false

# Verbatim texts: never reformat.
[{LICENSE,NOTICE}]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = unset

make: Entering directory '/opt/spike'
>> generating bpf/vmlinux.h from /sys/kernel/btf/vmlinux (7.2.0-61.fc45.x86_64)
bpftool btf dump file /sys/kernel/btf/vmlinux format c > bpf/vmlinux.h.tmp
skipping /sys/kernel/btf/vmlinux (will be loaded as base)
mv bpf/vmlinux.h.tmp bpf/vmlinux.h
>> compiling BPF object for x86
# -mcpu=v3: __sync_fetch_and_or with a used result needs BPF ISA v3 atomics.
# -fms-extensions: kernel 7.x BTF contains tagged anonymous struct members,
# which bpftool reproduces in vmlinux.h (for example "struct ns_tree;"
# inside a struct); clang rejects them under -Werror without the extension.
clang -O2 -g -Wall -Werror \
	-fms-extensions -Wno-microsoft-anon-tag \
	-target bpf -mcpu=v3 -D__TARGET_ARCH_x86 \
	-Ibpf -c bpf/label_probe.bpf.c -o label_probe.bpf.o
>> building Go probe
GOFLAGS=-mod=mod CGO_ENABLED=0 go build -o tidemark-probe ./cmd/tidemark-probe
go: downloading github.com/cilium/ebpf v0.22.0
go: downloading golang.org/x/sys v0.43.0
go vet ./...
>> running the Phase 0 kernel spike (root)
install -D -m 0755 tidemark-probe /usr/local/libexec/tidemark-probe
env \
	TM_ATTACH_MMAP_FILE="1" \
	TM_BPF_OBJ="/opt/spike/label_probe.bpf.o" \
	TM_TESTS_DIR="/opt/spike/tests" \
	TM_BPFFS="/sys/fs/bpf/tidemark" \
	TM_PROBE_BIN="/usr/local/libexec/tidemark-probe" \
	"/usr/local/libexec/tidemark-probe" run
